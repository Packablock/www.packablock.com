      "disclosure_program": "Kubernetes Security Response Committee (SRC) Bug Bounty"
    },
    "cra_status": {
      "support_tier": "Active Support",
      "end_of_life": false,
      "cra_risk_score": "Low (Active upstream SIG Architecture maintenance)"
    },
    "quirks": [
      {
        "title": "Unquoted Boolean Country Codes ('NO' / 'YES')",
        "description": "Under YAML 1.2 (JSON transcoding), 'country: NO' is parsed as the string 'NO' rather than boolean 'false', resolving the infamous YAML 1.1 Norway country code bug.",
        "code_bad": "# YAML 1.1 (e.g. PyYAML):\ncountry: NO       # Evaluates to boolean: false\n",
        "code_good": "# Kubernetes YAML 1.2 (sigs.k8s.io/yaml):\ncountry: NO       # Evaluates to string: \"NO\"\n"
      },
      {
        "title": "Duplicate Mapping Keys Rejection",
        "description": "To prevent shadow parameter injection attacks, duplicate keys in the same mapping block are rejected during JSON unmarshalling.",
        "code_bad": "spec:\n  replicas: 1\n  replicas: 5     # Shadow key rejected with parse error\n",
        "code_good": "spec:\n  replicas: 5     # Explicit single key assignment required\n"
      }
    ],
